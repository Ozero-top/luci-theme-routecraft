{% include('header', { blank_page: true }) %}
{% const rc_board = ubus.call('system', 'board'); -%}

<div class="rc-login">
	<div class="rc-login-card">
		<div class="rc-login-head">
			<span class="rc-brand-mark"></span>
			<div class="rc-login-title">
				<b>{{ striptags(rc_board.hostname ?? '?') }}</b>
				<span>ROUTECRAFT · LUCI CONSOLE</span>
			</div>
			<button class="rc-mode-btn rc-login-mode" id="rc-login-mode" type="button">MODE</button>
		</div>

		<section hidden>
			<form method="post" class="cbi-map">
				<div class="cbi-section">
					<div class="cbi-section-node">
						<div class="cbi-value">
							<label class="cbi-value-title" for="luci_username">{{ _('Username') }}</label>
							<div class="cbi-value-field">
								<input name="luci_username" id="luci_username" type="text" autocomplete="username" value="{{ entityencode(duser, true) }}">
							</div>
						</div>
						<div class="cbi-value">
							<label class="cbi-value-title" for="luci_password">{{ _('Password') }}</label>
							<div class="cbi-value-field">
								<input name="luci_password" id="luci_password" type="password" autocomplete="current-password">
							</div>
						</div>
					</div>
				</div>
			</form>

			{% if (fuser): %}
			<div class="alert-message error">
				{{ _('Invalid username and/or password! Please try again.') }}
			</div>
			{% endif %}

			<button class="btn cbi-button cbi-button-positive important" type="button">{{ _('Log in') }}</button>
		</section>

		<div id="view">
			<div class="spinning">{{ _('Loading view…') }}</div>
			<script>
				L.require('ui').then(function(ui) {
					ui.instantiateView('routecraft.sysauth');
				});
			</script>
		</div>

		<div class="rc-login-foot">
			<span>{{ entityencode(rc_board.release.description ?? 'iStoreOS', true) }}</span>
			<span>SEC // AUTH REQUIRED</span>
		</div>
	</div>
</div>

{% include('footer', { blank_page: true }) %}
